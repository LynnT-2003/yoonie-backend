        "method": "POST",
        "url": "={{ $('Config').item.json.api }}/concierge/bookings/lookup",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "keypair",
        "parametersBody": {
          "values": [
            {
              "name": "orderNumber",
              "valueProvider": "modelRequired",
              "description": "Booking number, e.g. TS-261025-AA70E"
            },
            {
              "name": "contact",
              "valueProvider": "modelRequired",
              "description": "Email or phone number on the booking"
            }
          ]
        }
      },
      "id": "0bf8f910-711e-48a5-aa23-ab31ad8aee47",
      "name": "lookup_booking",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
