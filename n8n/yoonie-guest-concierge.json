{
  "name": "Yoonie · Guest concierge",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "initialMessages": "Sawasdee ka! I'm Yoonie, your concierge. How can I help with your stay?",
        "options": {}
      },
