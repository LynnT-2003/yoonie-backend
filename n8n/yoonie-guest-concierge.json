    {
      "parameters": {
        "toolDescription": "Hotel facts: room types and nightly prices, tours, airport transfer and spa with prices and times, restaurant hours, check-in/out times, address.",
        "method": "GET",
        "url": "={{ $('Config').item.json.api }}/concierge/hotel",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "parametersQuery": {
          "values": [
            {
              "name": "branchCode",
              "valueProvider": "fieldValue",
              "value": "={{ $('Config').item.json.branchCode }}"
            }
          ]
        }
      },
      "id": "db0c5d9c-218d-4364-907a-751ae514a84e",
      "name": "hotel_info",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        300,
        320
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "yoonieConciergeKey",
          "name": "Yoonie concierge key"
        }
      }
    },
    {
      "parameters": {
        "toolDescription": "Rooms left and prices for a stay. Needs checkIn and checkOut dates as YYYY-MM-DD.",
        "method": "GET",
        "url": "={{ $('Config').item.json.api }}/concierge/availability",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "parametersQuery": {
          "values": [
            {
              "name": "branchCode",
              "valueProvider": "fieldValue",
              "value": "={{ $('Config').item.json.branchCode }}"
            },
            {
              "name": "checkIn",
              "valueProvider": "modelRequired",
              "description": "Arrival date YYYY-MM-DD"
            },
            {
              "name": "checkOut",
              "valueProvider": "modelRequired",
              "description": "Departure date YYYY-MM-DD"
            }
          ]
        }
      },
      "id": "3edefa53-c6c4-484c-8c8d-6961f1e966be",
      "name": "check_availability",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
