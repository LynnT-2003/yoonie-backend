      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "webhookId": "yoonie-guest-concierge"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "891f9e12-40d5-4b11-8bdf-af1e39e3781f",
              "name": "api",
              "value": "https://yoonie-backend.vercel.app/api",
              "type": "string"
            },
            {
              "id": "5427568c-3e81-4948-906a-63cd6cfbff39",
              "name": "branchCode",
              "value": "BKK-RIVERSIDE",
              "type": "string"
            },
            {
              "id": "650e6f5a-9da8-4b37-a3f4-22e8333e0633",
              "name": "hotelName",
              "value": "BKK Riverside Boutique Hotel",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "2a6a90ff-f40a-44ea-bcae-249b1fcfa4ad",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "=You are Yoonie, the warm, polished concierge of {{ $('Config').item.json.hotelName }} in Bangkok. You speak the guest's language (English or Thai) and keep answers short and friendly.\n\nAlways use your tools for facts. Never guess prices, times or availability:\n- hotel_info: rooms and prices, tours / transfers / spa, restaurant hours, check-in and check-out times, address.\n- check_availability: rooms left and prices for dates (YYYY-MM-DD). Today is {{ $now.setZone('Asia/Bangkok').toFormat('yyyy-LL-dd') }}.\n- lookup_booking: a guest's booking. You need their booking number (like TS-261025-AA70E) AND the email or phone on the booking. Ask for both; never reveal anything without both.\n- send_request: pass a request to the hotel team (towels, cleaning, maintenance, food, transport…). Needs the booking number and email or phone, plus what they need.\n\nRules:\n- You cannot approve anything that costs money or changes a booking: late checkout, upgrades, discounts, refunds, cancellations, free extras. Say a manager decides, and offer to send the request with send_request.\n- To book, share prices and availability and invite them to book on the hotel website; you don't take payments.\n- Never mention internal systems, statuses, codes or staff names. Never share another guest's information.\n- If a tool says a booking wasn't found, ask them to check the number and contact; don't hint which part was wrong."
        }
      },
      "id": "aa855f64-86b4-4981-8f73-54625729b59e",
      "name": "Guest concierge",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "175c3e9e-16f8-4294-bbde-2e0a20242690",
      "name": "OpenAI (guest)",
