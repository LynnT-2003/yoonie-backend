    {
      "parameters": {
        "jsCode": "// The gate: only a signed-in Yoonie staff member gets this far, and every tool runs as them\nconst me = $json.data;\nconst req = $('Staff message').item.json;\nif (!me || me.role === 'GUEST') {\n  return [{ json: { allowed: false } }];\n}\nreturn [{ json: {\n  allowed: true,\n  userId: me._id,\n  name: me.displayName,\n  role: me.role,\n  jobTitle: me.jobTitle || '',\n  branchId: (me.branchIds || [])[0],\n  today: new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Bangkok' }),\n  auth: req.headers.authorization,\n  sessionId: req.body.sessionId || me._id,\n  chatInput: String(req.body.message || req.body.chatInput || ''),\n  page: (req.body.context && req.body.context.page) || 'other',\n  roomNumber: (req.body.context && req.body.context.roomNumber) || '',\n  pageDate: (req.body.context && req.body.context.date) || new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Bangkok' }),\n  pageBrief: (() => {\n    const c = req.body.context || {};\n    const room = c.roomNumber ? ` They have room ${c.roomNumber} open: assume questions are about room ${c.roomNumber} unless they say otherwise, and use rooms_now to see it.` : '';\n    const briefs = {\n      rooms: 'They are on the ROOMS page (board, floor map, timeline). Go deep on rooms: use rooms_now for every room's cleaning state, who is in it tonight, who arrives and their ready-by time, departures, the room's job and owner, and each stay's bill. Compare against ready-by times; call out rooms that will be late.' + room,\n      guests: 'They are on the GUESTS page. Go deep on guests: use guests_now for who is in house, arriving, departing and due in the next 7 days, their bookings, services and balances.',\n      services: 'They are on the SERVICES page. Go deep on transfers, tours and spa: use services_now for each slot's capacity, bookings, revenue against cost and who is booked.',\n      dispatch: 'They are on the DISPATCH page. Go deep on today's jobs: use todays_jobs for rooms, pickups and tours with owners, steps and deadlines.',\n      property: 'They are on the PROPERTY page (rooms and services catalogue). Use rooms_now and services_now for facts.',\n    };\n    return briefs[c.page] || 'Answer about whatever they ask; todays_jobs is the best place to start.';\n  })(),\n} }];"
      },
