    {
      "parameters": {
        "jsCode": "// The gate: only a signed-in Yoonie staff member gets this far, and every tool runs as them\nconst me = $json.data;\nconst req = $('Staff message').item.json;\nif (!me || me.role === 'GUEST') {\n  return [{ json: { allowed: false } }];\n}\nreturn [{ json: {\n  allowed: true,\n  userId: me._id,\n  name: me.displayName,\n  role: me.role,\n  jobTitle: me.jobTitle || '',\n  branchId: (me.branchIds || [])[0],\n  today: new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Bangkok' }),\n  auth: req.headers.authorization,\n  sessionId: req.body.sessionId || me._id,\n  chatInput: String(req.body.message || req.body.chatInput || ''),\n} }];"
      },
      "id": "2e4825eb-4723-475a-979f-a11805d8dcf3",
      "name": "Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
