# App Configuration
APP_ENVIRONMENT=Development

# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yulio-next-js-frontend-starter.vercel.app
FRONTEND_OAUTH_CALLBACK_URL=https://yulio-next-js-frontend-starter.vercel.app/auth/callback
VERIFY_REDIRECT_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Rate Limiting
RATE_LIMIT_TIMEFRAME_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Max Sessions
MAX_SESSIONS=5

# API Key Guard
API_KEY=replace-me

# ──────────────────────────────────────────────────────────────────────────────
# Module-specific environment variables (added by `yulio add <module>`)
# Each module's env keys are declared in yulio.manifest.json. The CLI appends
# them to .env and .env.example with placeholder values when the module is
# installed, so this file stays focused on barebone defaults.
#
#   db-mongoose     — yulio init --db mongo    (MONGODB_URI)
#   db-postgres     — yulio init --db postgres (DATABASE_URL)
#   oauth providers — yulio add oauth-{google,line,github,discord,microsoft}
#   mail            — yulio add mail           (MAIL_*, COMPANY_*)
#   payment         — yulio add payment        (STRIPE_*)
#   upload          — yulio add upload         (R2_*)
# ──────────────────────────────────────────────────────────────────────────────

# ─── DATABASE ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ─── MAIL ──────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=noreply@yourapp.com
COMPANY_NAME=Your Company
COMPANY_LOGO_URL=https://yourapp.com/logo.png

# ─── CLOUDFLARE R2 STORAGE ─────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=yoonie-media
CLOUDFLARE_R2_PUBLIC_URL=https://images.yoonie.si

# ─── STAFF MOBILE OPS & NOTIFICATIONS ──────────────────
WORKER_ENABLED=false
INTERNAL_TICK_SECRET=your-internal-tick-secret-min-32-chars
EXPO_ACCESS_TOKEN=your-expo-access-token-optional

# ─── LINE MESSAGING API (OFFICIAL ACCOUNT) ──────────────
# IMPORTANT: Both LINE Login and LINE Messaging API channels MUST be created
# under the SAME LINE Developer Provider. This ensures that the user ID ('U...')
# is identical across login and messaging push APIs.
LINE_CHANNEL_ACCESS_TOKEN=your-line-messaging-api-channel-access-token
LINE_MESSAGING_CHANNEL_SECRET=your-line-messaging-channel-secret

# AI concierge (n8n) shared key: sent as x-concierge-key
CONCIERGE_API_KEY=

# Yoonie assistant (n8n): the web talks to these through /api/assistant/*
N8N_GUEST_CHAT_URL=https://<your-n8n>/webhook/yoonie-guest-concierge/chat
N8N_STAFF_WEBHOOK_URL=https://<your-n8n>/webhook/yoonie-staff-assistant
